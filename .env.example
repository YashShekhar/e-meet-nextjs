# E-Meet — Environment Variables
# Copy this file to .env.local and fill in values: `cp .env.example .env.local`

# Required: HMAC secret for host-token signing (room delete auth)
# Must be same across all instances / serverless replicas.
# Generate with: `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# If unset, src/lib/roomStore.ts:28 falls back to dev secret "e-meet-dev-secret-please-set-ROOM_HMAC_SECRET-in-prod" (NOT safe for production).
ROOM_HMAC_SECRET=change-me-to-a-random-64-hex-string-at-least-32-bytes

# Next.js — automatically set to "development" (next dev) or "production" (next build/start)
# Controls: CSP unsafe-eval in dev (next.config.ts:3), Secure cookie flag (src/app/api/rooms/route.ts:42)
# NODE_ENV=development
# NODE_ENV=production
